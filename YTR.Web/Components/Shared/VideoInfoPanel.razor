<MudPaper Class="@($"pa-4 {Class}")" Elevation="1" Style="max-height:150px;overflow:hidden;">
    @if (Metadata is not null)
    {
        <div style="display:flex;gap:16px;height:100%;max-height:118px;">
            @if (!string.IsNullOrEmpty(Metadata.ThumbnailUrl))
            {
                <div style="flex-shrink:0;">
                    <MudImage Src="@Metadata.ThumbnailUrl" Alt="Thumbnail"
                              ObjectFit="ObjectFit.Cover" Class="rounded"
                              Style="max-height:118px;width:auto;height:100%;" />
                </div>
            }
            <div style="overflow-y:auto;overflow-x:hidden;min-width:0;flex:1;">
                <MudText Typo="Typo.h6" Style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@Metadata.Title</MudText>
                @if (Metadata.Duration.HasValue)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Duration: @Metadata.Duration.Value.ToString(@"hh\:mm\:ss")
                    </MudText>
                }
                @if (!string.IsNullOrEmpty(Metadata.Uploader))
                {
                    <MudText Typo="Typo.body2">@Metadata.Uploader</MudText>
                }
                @if (!string.IsNullOrEmpty(Metadata.Description))
                {
                    <MudText Typo="Typo.body2" Class="mt-2" Style="word-break:break-word;">
                        @Metadata.Description
                    </MudText>
                }
            </div>
        </div>
    }
    else
    {
        <MudText Typo="Typo.body2" Color="Color.Tertiary" Align="Align.Center">
            Enter a URL and click "List Formats" to get started.
        </MudText>
    }
</MudPaper>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public MediaMetadata? Metadata { get; set; }
}
