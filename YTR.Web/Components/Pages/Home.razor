@page "/"
@inject IYtDlpService YtDlp
@inject IDownloadOrchestrator Orchestrator
@inject IUrlAnalyzer UrlAnalyzer
@inject ISettingsService Settings
@inject IPlatformService Platform
@inject IThumbnailService ThumbnailService
@inject IHistoryService HistoryService
@inject DownloadStateService State
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>YTR - Home</PageTitle>

<div class="home-layout">
    <div class="home-content">
        <div class="home-main" style="@MainStyle">
            <div class="home-fixed-top">
                <InputPanel @ref="_inputPanel" OnUrlAnalyzed="OnUrlAnalyzed" OnUrlChanged="OnUrlChanged" IsLoading="_loadingFormats"
                           HasData="_metadata is not null" HasOptions="_hasOptions" OnReset="ResetAll" />
                <VideoInfoPanel Class="mt-2" Metadata="_metadata" />
            </div>

            <div class="home-scrollable">
                @if (_metadata?.IsPlaylist == true && _metadata.PlaylistItems is not null)
                {
                    <PlaylistGrid Class="mt-2" Items="_metadata.PlaylistItems"
                                  SelectionChanged="OnPlaylistSelectionChanged" />
                }
                else
                {
                    <FormatGrid Class="mt-2" Formats="_formats"
                                FormatPairSelected="OnFormatPairSelected"
                                FormatSelected="OnFormatSelected" />
                }
            </div>
        </div>

        <div class="home-resize-grip" @ref="_gripElement"
             @onpointerdown="OnGripPointerDown"
             @onpointermove="OnGripPointerMove"
             @onpointerup="OnGripPointerUp"
             @onpointerdown:preventDefault
             @onpointermove:preventDefault>
            <div class="home-resize-grip-handle"></div>
        </div>

        <div class="home-sidebar" style="@SidebarStyle">
            <ControlPanel @ref="_controlPanel"
                          OnDownloadVideo="DownloadVideo"
                          OnDownloadAudio="DownloadAudio"
                          OnDownloadBest="DownloadBest"
                          Disabled="_downloading"
                          ShowDownloadSelected="_hasFormatSelection"
                          SelectedPair="_selectedPair"
                          ThumbnailUrl="@(_metadata?.ThumbnailUrl)"
                          MediaDuration="@(_metadata?.Duration)"
                          MediaWidth="@(BestVideoWidth)"
                          MediaHeight="@(BestVideoHeight)"
                          IsPlaylist="@(_metadata?.IsPlaylist == true)"
                          HasOptionsChanged="OnOptionsChanged" />
        </div>
    </div>

    <div class="home-status">
        <StatusBar ShowIndeterminate="_loadingFormats" />
    </div>
</div>

@if (_showErrorDialog)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="9999" OnClick="DismissError">
        <MudPaper Class="pa-6" Style="max-width:600px; margin:auto; margin-top:15vh;" Elevation="8" @onclick:stopPropagation="true">
            <MudText Typo="Typo.h6" Color="Color.Error" Class="mb-2">Download Failed</MudText>
            <MudText Typo="Typo.body2" Style="white-space:pre-wrap; word-break:break-word;">@_errorDetails</MudText>
            <MudAlert Severity="Severity.Info" Class="mt-4" Dense="true" NoIcon="false">
                These errors are usually caused by out-of-date dependencies.<br/>
                Visit <b>Settings → About</b> to check for available dependency updates.
            </MudAlert>
            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Default" OnClick="DismissError">Close</MudButton>
            </MudStack>
        </MudPaper>
    </MudOverlay>
}

@code {
    private MediaMetadata? _metadata;
    private IReadOnlyList<FormatInfo>? _formats;
    private FormatPair? _selectedPair;
    private FormatInfo? _selectedFormat;
    private IReadOnlyList<PlaylistItem>? _selectedPlaylistItems;
    private InputPanel? _inputPanel;
    private ControlPanel? _controlPanel;
    private bool _downloading;
    private bool _loadingFormats;
    private bool _hasFormatSelection;
    private bool _hasOptions;
    private string _currentUrl = string.Empty;
    private bool _showErrorDialog;
    private string? _errorDetails;

    [SupplyParameterFromQuery(Name = "url")]
    public string? InitialUrl { get; set; }

    [SupplyParameterFromQuery(Name = "redownload")]
    public string? RedownloadId { get; set; }

    // Resize grip state
    private const int MinMainWidth = 436;
    private const int MinSidebarWidth = 300;
    private const int GripWidth = 10;
    private bool _resizing;
    private double _resizeStartX;
    private double _startSidebarWidth;
    private double _maxSidebarWidth;
    private double? _sidebarWidth;
    private ElementReference _gripElement;

    private string MainStyle => _sidebarWidth.HasValue
        ? $"flex: 1; min-width: {MinMainWidth}px;"
        : $"flex: 2; min-width: {MinMainWidth}px;";

    private string SidebarStyle => _sidebarWidth.HasValue
        ? $"width: {_sidebarWidth.Value:0}px; flex: none; min-width: {MinSidebarWidth}px;"
        : $"min-width: {MinSidebarWidth}px;";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Subscribe to error events from the download state service
        State.OnErrorOccurred += OnDownloadError;

        // Handle "Use URL" navigation from history
        if (!string.IsNullOrWhiteSpace(InitialUrl))
        {
            _currentUrl = InitialUrl;
            _inputPanel?.SetUrl(InitialUrl);
            StateHasChanged();
        }
        // Handle "Re-download with same settings" from history
        else if (!string.IsNullOrWhiteSpace(RedownloadId) && Guid.TryParse(RedownloadId, out var recordId))
        {
            var record = await HistoryService.GetByIdAsync(recordId);
            if (record is not null)
            {
                _currentUrl = record.Url;
                _inputPanel?.SetUrl(record.Url);
                StateHasChanged();

                // Build a DownloadRequest from the saved record settings
                int[]? cropValues = null;
                if (!string.IsNullOrEmpty(record.CropValues))
                {
                    cropValues = record.CropValues.Split(',')
                        .Select(v => int.TryParse(v.Trim(), out var n) ? n : 0)
                        .ToArray();
                    if (cropValues.Length != 4) cropValues = null;
                }

                var request = new DownloadRequest
                {
                    SegmentStart = record.SegmentStart,
                    SegmentDuration = record.SegmentDuration,
                    CropValues = cropValues,
                    ConvertVideo = record.VideoConversion,
                    ConvertAudio = record.AudioConversion
                };

                await ExecuteDownload(record.StreamKind, request);
            }
        }
    }

    private async Task OnGripPointerDown(PointerEventArgs e)
    {
        _resizing = true;
        _resizeStartX = e.ClientX;
        _startSidebarWidth = _sidebarWidth ?? 340;

        // Get available container width so we can enforce min-main-width
        var contentWidth = await JS.InvokeAsync<double>("resizeGrip.getContentWidth", _gripElement);
        _maxSidebarWidth = contentWidth > 0
            ? contentWidth - MinMainWidth - GripWidth
            : double.MaxValue;

        await JS.InvokeVoidAsync("resizeGrip.capture", _gripElement, e.PointerId);
    }

    private void OnGripPointerMove(PointerEventArgs e)
    {
        if (!_resizing) return;

        var delta = _resizeStartX - e.ClientX;
        var newWidth = _startSidebarWidth + delta;

        if (newWidth < MinSidebarWidth)
            newWidth = MinSidebarWidth;
        if (newWidth > _maxSidebarWidth)
            newWidth = _maxSidebarWidth;

        _sidebarWidth = newWidth;
        StateHasChanged();
    }

    private async Task OnGripPointerUp(PointerEventArgs e)
    {
        _resizing = false;
        await JS.InvokeVoidAsync("resizeGrip.release", _gripElement, e.PointerId);
    }

    private async Task OnUrlChanged(string url)
    {
        // If formats were already fetched and the URL changes, reset everything
        if (_metadata is not null && url != _currentUrl)
        {
            _metadata = null;
            _formats = null;
            _selectedPair = null;
            _selectedFormat = null;
            _selectedPlaylistItems = null;
            _hasFormatSelection = false;
            State.UpdateStatus(string.Empty);
        }
        _currentUrl = url;

        // Reset media-specific options and flash persistent ones
        if (_controlPanel is not null)
            await _controlPanel.OnUrlChangedAsync();

        StateHasChanged();
    }

    private void ResetAll()
    {
        _currentUrl = string.Empty;
        _metadata = null;
        _formats = null;
        _selectedPair = null;
        _selectedFormat = null;
        _selectedPlaylistItems = null;
        _hasFormatSelection = false;
        _hasOptions = false;
        State.UpdateStatus(string.Empty);
        _controlPanel?.ResetOptions();
    }

    private async Task OnUrlAnalyzed(UrlAnalysisResult analysis)
    {
        if (!analysis.IsValid) return;

        _currentUrl = analysis.NormalizedUrl;
        State.UpdateStatus("Fetching formats...");
        _metadata = null;
        _formats = null;
        _selectedPair = null;
        _selectedFormat = null;
        _hasFormatSelection = false;
        _loadingFormats = true;
        StateHasChanged();

        var result = analysis.IsPlaylist
            ? await YtDlp.GetPlaylistInfoAsync(analysis.NormalizedUrl)
            : await YtDlp.GetMediaInfoAsync(analysis.NormalizedUrl);

        if (result.IsSuccess && result.Value is not null)
        {
            _metadata = result.Value;
            _formats = FilterFormats(result.Value.Formats);
            State.UpdateStatus($"Found {_formats.Count} formats.");

            // If the thumbnail doesn't match the video's aspect ratio, crop it
            if (!_metadata.ThumbnailAspectRatioMatched
                && !string.IsNullOrEmpty(_metadata.ThumbnailUrl)
                && BestVideoWidth.HasValue && BestVideoHeight.HasValue && BestVideoHeight.Value > 0)
            {
                var targetRatio = (double)BestVideoWidth.Value / BestVideoHeight.Value;
                var croppedUri = await ThumbnailService.GetCroppedThumbnailAsync(_metadata.ThumbnailUrl, targetRatio);
                if (croppedUri is not null)
                {
                    _metadata = _metadata with { ThumbnailUrl = croppedUri, ThumbnailAspectRatioMatched = true };
                }
            }
        }
        else
        {
            State.UpdateStatus($"Error: {result.Error}");
        }
        _loadingFormats = false;
        StateHasChanged();
    }

    private void OnFormatPairSelected(FormatPair pair)
    {
        _selectedPair = pair;
        _hasFormatSelection = pair.IsValid;
        StateHasChanged();
    }

    private void OnFormatSelected(FormatInfo? format)
    {
        _selectedFormat = format;
    }

    private void OnPlaylistSelectionChanged(IReadOnlyList<PlaylistItem> items)
    {
        _selectedPlaylistItems = items;
    }

    private void OnOptionsChanged(bool hasOptions)
    {
        _hasOptions = hasOptions;
        StateHasChanged();
    }

    private async Task DownloadVideo(DownloadRequest request)
    {
        // "Download Selected Format" — use the StreamKind from the selected pair
        var kind = _selectedPair?.StreamKind ?? StreamKind.Video;
        await ExecuteDownload(kind, request);
    }
    private async Task DownloadAudio(DownloadRequest request) => await ExecuteDownload(StreamKind.Audio, request);
    private async Task DownloadBest(DownloadRequest request) => await ExecuteDownload(StreamKind.AudioAndVideo, request);

    private async Task ExecuteDownload(StreamKind streamKind, DownloadRequest request)
    {
        // If metadata hasn't been fetched yet (user didn't click List Formats), fetch it now
        if (_metadata is null)
        {
            if (string.IsNullOrWhiteSpace(_currentUrl)) return;

            var analysis = UrlAnalyzer.Analyze(_currentUrl);
            if (!analysis.IsValid) return;

            State.UpdateStatus("Fetching media info...");
            _loadingFormats = true;
            StateHasChanged();

            var infoResult = analysis.IsPlaylist
                ? await YtDlp.GetPlaylistInfoAsync(analysis.NormalizedUrl)
                : await YtDlp.GetMediaInfoAsync(analysis.NormalizedUrl);

            _loadingFormats = false;

            if (infoResult.IsFailure || infoResult.Value is null)
            {
                State.UpdateStatus($"Error: {infoResult.Error}");
                StateHasChanged();
                return;
            }

            _metadata = infoResult.Value;
            // Don't populate _formats — we only fetched metadata for the title/duration,
            // not because the user asked to see the format list
        }

        // Attach the media title and duration so downstream services can use them
        var videoAspectRatio = (BestVideoWidth.HasValue && BestVideoHeight.HasValue && BestVideoHeight.Value > 0)
            ? (double)BestVideoWidth.Value / BestVideoHeight.Value
            : (double?)null;
        request = request with { Title = _metadata.Title, MediaDuration = _metadata.Duration, Uploader = _metadata.Uploader, ThumbnailUrl = _metadata.OriginalThumbnailUrl, VideoAspectRatio = videoAspectRatio, AvailableFormats = _metadata.Formats };

        // Revalidate segment values against actual media duration (may not have been known at BuildRequest time)
        if (_metadata.Duration.HasValue)
        {
            var maxDuration = _metadata.Duration.Value;
            var segStart = request.SegmentStart;
            var segDuration = request.SegmentDuration;
            bool segChanged = false;

            if (segStart.HasValue && segStart.Value >= maxDuration)
            {
                segStart = maxDuration - TimeSpan.FromSeconds(1);
                if (segStart.Value < TimeSpan.Zero) segStart = TimeSpan.Zero;
                segChanged = true;
            }

            if (segDuration.HasValue)
            {
                var effectiveStart = segStart ?? TimeSpan.Zero;
                if (effectiveStart + segDuration.Value > maxDuration)
                {
                    segDuration = maxDuration - effectiveStart;
                    segChanged = true;
                }
                if (segDuration.Value < TimeSpan.FromSeconds(1))
                {
                    segDuration = TimeSpan.FromSeconds(1);
                    segChanged = true;
                }
            }

            if (segChanged)
            {
                request = request with { SegmentStart = segStart, SegmentDuration = segDuration };
                _controlPanel?.UpdateSegmentValues(segStart, segDuration);
                StateHasChanged();
            }
        }

        // Revalidate crop values against actual video dimensions
        if (request.CropValues is { Length: 4 } cropVals)
        {
            var vw = BestVideoWidth;
            var vh = BestVideoHeight;

            if (vw.HasValue && vh.HasValue)
            {
                var clamped = CropHelper.ClampMargins(cropVals, vw.Value, vh.Value);
                if (clamped[0] != cropVals[0] || clamped[1] != cropVals[1]
                    || clamped[2] != cropVals[2] || clamped[3] != cropVals[3])
                {
                    request = request with { CropValues = clamped };
                    _controlPanel?.UpdateCropValues(clamped[0], clamped[1], clamped[2], clamped[3]);
                    StateHasChanged();
                }
            }
        }

        _downloading = true;
        StateHasChanged();

        var ct = State.StartOperation();
        var progress = new Progress<DownloadProgress>(p =>
        {
            State.UpdateProgress(p);
            InvokeAsync(StateHasChanged);
        });
        var output = new Progress<string>(msg => State.UpdateStatus(msg));

        try
        {
            if (_metadata.IsPlaylist && _metadata.PlaylistItems is not null)
            {
                var items = _selectedPlaylistItems ?? _metadata.PlaylistItems;
                var playlistProgress = new Progress<PlaylistProgress>(p =>
                {
                    State.UpdatePlaylistProgress(p.Completed, p.Total);
                    InvokeAsync(StateHasChanged);
                });

                var playlistRequest = request with { PlaylistFolder = _metadata.Title?.Replace(" ", "") ?? "Playlist" };
                var result = await Orchestrator.DownloadPlaylistAsync(
                    _metadata.Url, items, streamKind, playlistRequest, progress, output, playlistProgress, ct);

                State.ResetPlaylist();
                if (result.IsSuccess)
                    State.UpdateStatus($"Playlist complete: {result.Value} items downloaded.");
                else
                    State.UpdateStatus($"Failed: {result.Error}");
            }
            else if (_selectedPair is not null && _selectedPair.IsValid)
            {
                var result = await Orchestrator.DownloadFormatAsync(_metadata.Url, _selectedPair, request, progress, output, ct);
                HandleResult(result);
            }
            else
            {
                var result = await Orchestrator.DownloadBestAsync(_metadata.Url, streamKind, request, progress, output, ct);
                HandleResult(result);
            }
        }
        catch (OperationCanceledException)
        {
            State.UpdateStatus("Download cancelled.");
        }
        catch (Exception ex)
        {
            State.UpdateStatus($"Error: {ex.Message}");
        }
        finally
        {
            _downloading = false;
            State.Reset();
            StateHasChanged();
        }
    }

    private void HandleResult(Result<DownloadRecord> result)
    {
        if (result.IsSuccess)
        {
            State.UpdateStatus($"Complete: {result.Value!.Title}");
            if (Settings.Download.AutoOpenDownloadLocation)
            {
                _ = Platform.OpenFolderAsync(result.Value.FilePath);
            }
        }
        else
        {
            State.ReportError(result.Error ?? "Download failed.");
        }
    }

    private void OnDownloadError(string error)
    {
        _errorDetails = error;
        _showErrorDialog = true;
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Called externally (e.g. from QuickDownloadHandler "View Details") to show full error in the main app.
    /// </summary>
    public void ShowErrorDetails(string error)
    {
        _errorDetails = error;
        _showErrorDialog = true;
        InvokeAsync(StateHasChanged);
    }

    private void DismissError()
    {
        _showErrorDialog = false;
        _errorDetails = null;
        State.ClearError();
    }

    public void Dispose()
    {
        State.OnErrorOccurred -= OnDownloadError;
    }

    /// <summary>
    /// Best video format dimensions from metadata (used for crop validation when no format is selected).
    /// </summary>
    private int? BestVideoWidth => _metadata?.Formats
        .Where(f => f.Width.HasValue && f.Height.HasValue)
        .OrderByDescending(f => f.Height)
        .FirstOrDefault()?.Width;

    private int? BestVideoHeight => _metadata?.Formats
        .Where(f => f.Width.HasValue && f.Height.HasValue)
        .OrderByDescending(f => f.Height)
        .FirstOrDefault()?.Height;

    private IReadOnlyList<FormatInfo> FilterFormats(IReadOnlyList<FormatInfo> formats)
    {
        var maxRes = _controlPanel?.ActiveMaxResolutionPixels ?? 0;
        var maxSizeMb = _controlPanel?.ActiveMaxFileSizeMb ?? 0;

        if (maxRes == 0 && maxSizeMb == 0)
            return formats;

        var maxSizeBytes = maxSizeMb > 0 ? (long)maxSizeMb * 1024 * 1024 : 0;

        return formats.Where(f =>
        {
            // Filter by resolution: exclude video formats that exceed max height
            if (maxRes > 0 && f.Height.HasValue && f.Height.Value > maxRes)
                return false;

            // Filter by file size: exclude formats that exceed max size
            if (maxSizeBytes > 0)
            {
                var size = f.FileSize ?? f.ApproximateFileSize ?? 0;
                if (size > 0 && size > maxSizeBytes)
                    return false;
            }

            return true;
        }).ToList();
    }
}
